# syntax=docker/dockerfile:1
#
# Dockerfile chay test tren moi truong Docker (local / isolated test runner).
# Luu y: Cac thu muc src/test duoc cau hinh local-only (.gitignore) de giu rieng tren may dev,
# khong push len Git. File nay ho tro chay bo test local trong moi truong container dong nhat:
# `docker build -f Dockerfile.test .`

FROM maven:3.9-eclipse-temurin-25
WORKDIR /workspace

COPY pom.xml .

RUN mvn -B -q dependency:go-offline || true

COPY src src

# Run the tests:
RUN mvn -B test
