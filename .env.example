# =============================================================================
# DrMayDay Backend - Environment Configuration Template (.env.example)
# =============================================================================

# --- Database (PostgreSQL) ---
DB_URL=

# --- Redis ---
REDIS_HOST=localhost
REDIS_HOST_PORT=6379
REDIS_PASSWORD=

# --- Application Server ---
SERVER_PORT=8080
APP_HOST_PORT=8080

# --- Security / JWT ---
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-please-use-strong-secret
JWT_ACCESS_EXP=3600000
JWT_REFRESH_EXP=604800000

# --- Password reset / SpeedSMS ---
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=5
SPEEDSMS_API_URL=https://api.speedsms.vn/index.php/sms/send
SPEEDSMS_API_TOKEN=
SPEEDSMS_SMS_TYPE=4
SPEEDSMS_SENDER=
SPEEDSMS_PASSWORD_RESET_MESSAGE="Ma xac thuc DrMayDay cua ban la %s. Ma co hieu luc trong %d phut."

# --- Logging ---
LOG_LEVEL=INFO