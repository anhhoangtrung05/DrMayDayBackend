<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.drmayday</groupId>
    <artifactId>drmayday-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>drmayday-backend</name>
    <description>DrMayDay Backend - He thong quan ly kham benh &amp; theo doi benh me day/da lieu</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.34</lombok.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <modules>
        <module>common</module>
        <module>facility</module>
        <module>auth-rbac</module>
        <module>form-builder</module>
        <module>medical-record</module>
        <module>media</module>
        <module>lesion-tracking</module>
        <module>lab</module>
        <module>prescription</module>
        <module>notification</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>facility</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>auth-rbac</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>form-builder</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>medical-record</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>media</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>lesion-tracking</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>lab</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>prescription</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drmayday</groupId>
                <artifactId>notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
